{
  "expo": {
    "name": "biblioteca-app",
    "slug": "biblioteca-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bibliotecaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true },
    "android": { "adaptiveIcon": { "backgroundColor": "#ffffff" } },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": false }
  }
}
